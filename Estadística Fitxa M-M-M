    <script>
        // Globals per emmagatzemar dades de l'exercici
        let row1Data = [0, 4, 6, 6];
        let row2Data = [-8, -4, 0, 0];
        let attempts = 0;

        function initApp() {
            const savedState = document.body.getAttribute('data-state');
            const savedIntents = parseInt(document.body.getAttribute('data-intents') || '0');
            attempts = savedIntents;
            const attemptsElem = document.getElementById('attempts-count');
            if (attemptsElem) attemptsElem.textContent = attempts;

            if (savedState === 'solved') {
                checkAnswers(true);
            }
        }

        function parseNum(val) {
            if (val === null || val === undefined) return NaN;
            let clean = val.toString().trim().replace(',', '.');
            if (clean === '' || isNaN(clean)) return NaN;
            return parseFloat(clean);
        }

        function calculateStats(arr) {
            if (!Array.isArray(arr) || arr.length === 0 || arr.some(isNaN)) {
                return { mean: NaN, median: NaN, modes: [] };
            }

            const sorted = [...arr].sort((a, b) => a - b);
            const mean = sorted.reduce((a, b) => a + b, 0) / sorted.length;
            const mid = Math.floor(sorted.length / 2);
            const median = sorted.length % 2 !== 0 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;

            const freq = {};
            let maxFreq = 0;
            sorted.forEach(x => {
                freq[x] = (freq[x] || 0) + 1;
                if (freq[x] > maxFreq) maxFreq = freq[x];
            });

            let modes = [];
            if (maxFreq > 1) {
                for (let k in freq) {
                    if (freq[k] === maxFreq) modes.push(parseFloat(k));
                }
            }

            return {
                mean: Math.round(mean * 100) / 100,
                median: Math.round(median * 100) / 100,
                modes: modes
            };
        }

        function checkAnswers(isReadOnlyCheck = false) {
            try {
                if (!isReadOnlyCheck) {
                    attempts++;
                    document.body.setAttribute('data-intents', attempts);
                }
                
                const attemptsElem = document.getElementById('attempts-count');
                if (attemptsElem) attemptsElem.textContent = attempts;

                let correctCount = 0;
                let totalFields = 0;

                function applyStatus(el, isCorrect) {
                    if (!el) return;
                    totalFields++;
                    el.classList.remove('border-slate-300', 'text-blue-900', 'bg-emerald-100', 'border-emerald-500', 'text-emerald-900', 'bg-red-100', 'border-red-500', 'text-red-900');
                    if (isCorrect) {
                        correctCount++;
                        el.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
                    } else {
                        el.classList.add('bg-red-100', 'border-red-500', 'text-red-900');
                    }
                }

                // BLOC 1
                const q1 = document.getElementById('b1-q1');
                if (q1) applyStatus(q1, q1.value === 'moda');

                const q2 = document.getElementById('b1-q2');
                if (q2) applyStatus(q2, q2.value === 'mitjana_centrals');

                const q3 = document.getElementById('b1-q3');
                if (q3) applyStatus(q3, parseNum(q3.value) === 24);

                // FILA 1
                const stats1 = calculateStats(row1Data);
                const r1Mean = document.getElementById('r1-mean');
                const r1Median = document.getElementById('r1-median');
                const r1Mode = document.getElementById('r1-mode');

                if (r1Mean) applyStatus(r1Mean, Math.abs(parseNum(r1Mean.value) - stats1.mean) < 0.01);
                if (r1Median) applyStatus(r1Median, Math.abs(parseNum(r1Median.value) - stats1.median) < 0.01);
                if (r1Mode) {
                    const val1Mode = parseNum(r1Mode.value);
                    applyStatus(r1Mode, !isNaN(val1Mode) && Array.isArray(stats1.modes) && stats1.modes.includes(val1Mode));
                }

                // FILA 2
                const stats2 = calculateStats(row2Data);
                const r2Mean = document.getElementById('r2-mean');
                const r2Median = document.getElementById('r2-median');
                const r2Mode = document.getElementById('r2-mode');

                if (r2Mean) applyStatus(r2Mean, Math.abs(parseNum(r2Mean.value) - stats2.mean) < 0.01);
                if (r2Median) applyStatus(r2Median, Math.abs(parseNum(r2Median.value) - stats2.median) < 0.01);
                if (r2Mode) {
                    const val2Mode = parseNum(r2Mode.value);
                    applyStatus(r2Mode, !isNaN(val2Mode) && Array.isArray(stats2.modes) && stats2.modes.includes(val2Mode));
                }

                // FILA 3
                const r3d1 = document.getElementById('r3-d1');
                const r3d2 = document.getElementById('r3-d2');
                const r3Mean = document.getElementById('r3-mean');

                const v3d1 = r3d1 ? parseNum(r3d1.value) : NaN;
                const v3d2 = r3d2 ? parseNum(r3d2.value) : NaN;
                const v3Mean = r3Mean ? parseNum(r3Mean.value) : NaN;

                const isR3DataValid = !isNaN(v3d1) && !isNaN(v3d2) && v3d1 <= v3d2 && v3d2 === 6;
                if (r3d1) applyStatus(r3d1, !isNaN(v3d1) && v3d1 <= 6);
                if (r3d2) applyStatus(r3d2, v3d2 === 6);
                
                const expectedR3Mean = (v3d1 + 6 + 8 + 8) / 4;
                if (r3Mean) applyStatus(r3Mean, !isNaN(v3Mean) && isR3DataValid && Math.abs(v3Mean - expectedR3Mean) < 0.01);

                // FILA 4
                const r4d3 = document.getElementById('r4-d3');
                const r4d4 = document.getElementById('r4-d4');

                const v4d3 = r4d3 ? parseNum(r4d3.value) : NaN;
                const v4d4 = r4d4 ? parseNum(r4d4.value) : NaN;

                if (r4d3) applyStatus(r4d3, v4d3 === 5);
                if (r4d4) applyStatus(r4d4, v4d4 === 24);

                // FILA 5
                const r5d1 = document.getElementById('r5-d1');
                const r5d2 = document.getElementById('r5-d2');
                const r5d3 = document.getElementById('r5-d3');
                const r5Median = document.getElementById('r5-median');

                const v5d1 = r5d1 ? parseNum(r5d1.value) : NaN;
                const v5d2 = r5d2 ? parseNum(r5d2.value) : NaN;
                const v5d3 = r5d3 ? parseNum(r5d3.value) : NaN;
                const v5Median = r5Median ? parseNum(r5Median.value) : NaN;

                if (r5d1) applyStatus(r5d1, v5d1 === 5);
                if (r5d2) applyStatus(r5d2, v5d2 === 5);
                if (r5d3) applyStatus(r5d3, v5d3 === 5.5);
                if (r5Median) applyStatus(r5Median, Math.abs(v5Median - 5.25) < 0.01);

                const summaryBox = document.getElementById('summary-box');
                const summaryTitle = document.getElementById('summary-title');
                const summaryText = document.getElementById('summary-text');
                const summaryScore = document.getElementById('summary-score');
                const summaryAttempts = document.getElementById('summary-attempts');

                if (summaryBox) {
                    summaryBox.classList.remove(
                        'hidden', 
                        'bg-emerald-50', 'border-emerald-300', 'text-emerald-950',
                        'bg-blue-50', 'border-blue-300', 'text-blue-950',
                        'bg-amber-50', 'border-amber-300', 'text-amber-950',
                        'bg-rose-50', 'border-rose-300', 'text-rose-950'
                    );

                    const percentage = totalFields > 0 ? Math.round((correctCount / totalFields) * 100) : 0;

                    if (percentage === 100) {
                        summaryBox.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-950');
                        if (summaryTitle) summaryTitle.textContent = "🎉 Excel·lent treball!";
                        if (summaryText) summaryText.textContent = "Has resolt totes les activitats correctament i has demostrat un domini complet de les mesures de centralització.";
                    } else if (percentage >= 75) {
                        summaryBox.classList.add('bg-blue-50', 'border-blue-300', 'text-blue-950');
                        if (summaryTitle) summaryTitle.textContent = "👍 Molt bon treball!";
                        if (summaryText) summaryText.textContent = "Estàs molt a prop del 100%. Revisa les poques caselles vermelles per acabar de corregir els petits detalls.";
                    } else if (percentage >= 50) {
                        summaryBox.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-950');
                        if (summaryTitle) summaryTitle.textContent = "💪 Bon intent! Vas per bon camí.";
                        if (summaryText) summaryText.textContent = "Has superat la meitat dels exercicis. Revisa les caselles en vermell comprovant l'ordre ascendent de les dades i les fórmules.";
                    } else {
                        summaryBox.classList.add('bg-rose-50', 'border-rose-300', 'text-rose-950');
                        if (summaryTitle) summaryTitle.textContent = "🧩 Continua practicant!";
                        if (summaryText) summaryText.textContent = "Encara queden conceptes per revisar. Repassa les pautes de la capçalera i torna a calcular les caselles vermelles pas a pas.";
                    }

                    if (summaryScore) summaryScore.textContent = `${correctCount} / ${totalFields} (${percentage}%)`;
                    if (summaryAttempts) summaryAttempts.textContent = `Intent nº ${attempts}`;
                }

                // Bloquejar camps
                document.querySelectorAll('input, select').forEach(el => {
                    if (el.id !== 'student-name' && el.id !== 'student-group') {
                        el.disabled = true;
                    }
                });

                // Canviar botons visibles
                const checkBtn = document.getElementById('check-btn');
                if (checkBtn) checkBtn.classList.add('hidden');
                
                const retryBtn = document.getElementById('retry-btn');
                if (retryBtn) retryBtn.classList.remove('hidden');

                const downloadBtn = document.getElementById('download-btn');
                if (downloadBtn) downloadBtn.classList.remove('hidden');

            } catch (err) {
                console.error("S'ha produït un error durant la correcció:", err);
            }
        }

        function retryWorksheet() {
            // Desbloquejar camps i eliminar fons de colors
            document.querySelectorAll('input, select').forEach(el => {
                if (el.id !== 'student-name' && el.id !== 'student-group') {
                    el.disabled = false;
                    el.classList.remove(
                        'bg-emerald-100', 'border-emerald-500', 'text-emerald-900',
                        'bg-red-100', 'border-red-500', 'text-red-900'
                    );
                    el.classList.add('border-slate-300', 'text-blue-900');
                }
            });

            const summaryBox = document.getElementById('summary-box');
            if (summaryBox) summaryBox.classList.add('hidden');

            const checkBtn = document.getElementById('check-btn');
            if (checkBtn) {
                checkBtn.disabled = false;
                checkBtn.classList.remove('hidden');
            }

            const retryBtn = document.getElementById('retry-btn');
            if (retryBtn) retryBtn.classList.add('hidden');

            const downloadBtn = document.getElementById('download-btn');
            if (downloadBtn) downloadBtn.classList.add('hidden');
        }

        async function downloadWorksheet() {
            // 1. Substituir temporalment els inputs i selects per DIVs de text nítid per evitar retalls a html2canvas
            const inputsAndSelects = document.querySelectorAll('input, select');
            const replacements = [];

            inputsAndSelects.forEach(el => {
                const style = window.getComputedStyle(el);
                
                let text = '';
                if (el.tagName.toLowerCase() === 'select') {
                    if (el.selectedIndex >= 0 && el.options[el.selectedIndex]) {
                        text = el.options[el.selectedIndex].text;
                    } else {
                        text = '-- Selecciona --';
                    }
                } else {
                    text = el.value || el.placeholder || '';
                }

                const div = document.createElement('div');
                div.className = el.className;
                
                // Copiar valors d'estil per mantenir la geometria exacta i el fons de correcció
                const isCentered = (style.textAlign === 'center' || el.classList.contains('text-center'));

                div.style.width = style.width;
                div.style.height = style.height;
                div.style.minHeight = style.minHeight;
                div.style.display = 'flex';
                div.style.alignItems = 'center';
                div.style.justifyContent = isCentered ? 'center' : 'flex-start';
                div.style.paddingLeft = isCentered ? '0px' : (style.paddingLeft !== '0px' ? style.paddingLeft : '6px');
                div.style.paddingRight = isCentered ? '0px' : (style.paddingRight !== '0px' ? style.paddingRight : '6px');
                div.style.paddingTop = '0px';
                div.style.paddingBottom = '0px';
                div.style.fontSize = style.fontSize;
                div.style.fontWeight = style.fontWeight;
                div.style.color = style.color;
                div.style.backgroundColor = style.backgroundColor;
                div.style.borderColor = style.borderColor;
                div.style.borderWidth = style.borderWidth;
                div.style.borderStyle = style.borderStyle;
                div.style.borderRadius = style.borderRadius;
                div.style.boxSizing = 'border-box';
                div.style.overflow = 'hidden';
                div.style.whiteSpace = 'nowrap';
                div.style.textOverflow = 'ellipsis';
                div.style.lineHeight = '1';
                
                div.textContent = text;

                const origDisplay = el.style.display;
                el.style.display = 'none';
                el.parentNode.insertBefore(div, el);

                replacements.push({ el, div, origDisplay });
            });

            document.body.setAttribute('data-state', 'solved');

            const rawName = document.getElementById('student-name')?.value || 'Alumne';
            const rawGroup = document.getElementById('student-group')?.value || 'Grup';

            const cleanName = rawName.trim().replace(/[^a-zA-Z0-9àáèéíòóúçÀÁÈÉÍÒÓÚÇ_]/g, '_') || 'Alumne';
            const cleanGroup = rawGroup.trim().replace(/[^a-zA-Z0-9]/g, '_') || 'Grup';

            const fileName = `${cleanName}_${cleanGroup}_Estadistica_Mesures_Centralitzacio.pdf`;

            const element = document.querySelector('main');
            const actionButtonsRow = document.getElementById('action-buttons-row');

            // Amagar temporalment la fila de botons d'acció per al PDF final
            if (actionButtonsRow) actionButtonsRow.style.display = 'none';

            // Guardar estils originals
            const originalBodyStyle = document.body.getAttribute('style') || '';
            const originalElementStyle = element.getAttribute('style') || '';

            // Establir maquetació fixa proporcional A4 per al processament del PDF
            document.body.style.padding = '0';
            document.body.style.margin = '0';
            document.body.style.background = '#ffffff';

            element.style.width = '794px';
            element.style.maxWidth = '794px';
            element.style.minHeight = '1050px';
            element.style.padding = '24px 28px';
            element.style.boxShadow = 'none';
            element.style.border = 'none';
            element.style.borderRadius = '0';
            element.style.margin = '0 auto';
            element.style.display = 'flex';
            element.style.flexDirection = 'column';
            element.style.justifyContent = 'space-between';

            try {
                window.scrollTo(0, 0);

                const canvas = await html2canvas(element, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    scrollX: 0,
                    scrollY: 0,
                    windowWidth: 800
                });

                // Restaurar interfície d'usuari i inputs originals
                if (actionButtonsRow) actionButtonsRow.style.display = 'flex';
                element.setAttribute('style', originalElementStyle);
                document.body.setAttribute('style', originalBodyStyle);

                replacements.forEach(({ el, div, origDisplay }) => {
                    el.style.display = origDisplay;
                    if (div.parentNode) div.parentNode.removeChild(div);
                });

                // Crear el PDF escalat exactament a 1 pàgina A4 completa i centrada
                const { jsPDF } = window.jspdf || {};

                if (jsPDF) {
                    const pdf = new jsPDF('p', 'mm', 'a4');
                    const pdfWidth = pdf.internal.pageSize.getWidth();   // 210 mm
                    const pdfHeight = pdf.internal.pageSize.getHeight(); // 297 mm
                    
                    const margin = 8; // 8mm de marge
                    const maxWidth = pdfWidth - (margin * 2);   // 194 mm
                    const maxHeight = pdfHeight - (margin * 2); // 281 mm

                    let imgWidth = maxWidth;
                    let imgHeight = (canvas.height * imgWidth) / canvas.width;

                    if (imgHeight > maxHeight) {
                        imgHeight = maxHeight;
                        imgWidth = (canvas.width * imgHeight) / canvas.height;
                    }

                    const xPos = (pdfWidth - imgWidth) / 2; // Centrat horitzontal
                    const yPos = (pdfHeight - imgHeight) / 2; // Centrat vertical

                    const imgData = canvas.toDataURL('image/jpeg', 0.98);
                    pdf.addImage(imgData, 'JPEG', xPos, yPos, imgWidth, imgHeight);
                    pdf.save(fileName);
                } else {
                    window.print();
                }
            } catch (err) {
                console.error("Error en generar el PDF:", err);
                if (actionButtonsRow) actionButtonsRow.style.display = 'flex';
                element.setAttribute('style', originalElementStyle);
                document.body.setAttribute('style', originalBodyStyle);
                
                replacements.forEach(({ el, div, origDisplay }) => {
                    el.style.display = origDisplay;
                    if (div.parentNode) div.parentNode.removeChild(div);
                });

                window.print();
            }
        }

        if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', initApp);
        } else {
            initApp();
        }
    </script>
